{
  "manifest_version": 3,
  "name": "AI Archive — Claude Sync",
  "version": "0.5.5",
  "description": "Sync Claude.ai conversations, active branches, tool calls, inline images, and portable files to a private GitHub repository used as your AI Archive.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Archive"
  }
}
